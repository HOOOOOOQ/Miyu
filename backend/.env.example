# Miyu backend environment — copy to .env and fill in real values.
# NEVER commit .env. Placeholders only below.

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# MongoDB Atlas (backend only — never expose to Flutter)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/miyu?retryWrites=true&w=majority

# JWT secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (backend verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebRTC TURN (managed TURN provider — never hardcode in Flutter)
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS (comma-separated origins; * in dev only)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:5000

# Upload limits
MAX_FILE_SIZE_MB=25
